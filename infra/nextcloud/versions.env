# Pinned byebyemoneylist release deployed into the Nextcloud AIO container.
#
# This file is intentionally committed and holds no secrets. Bump BYML_VERSION
# after publishing a new release in the app repo (rykhalskyi/byebyemoneylist-ns),
# then run `make nc-app-deploy` on node-one.
#
# BYML_SHA256 is the checksum of byebyemoneylist-<version>.tar.gz as published
# by the app repo's release workflow. Leave it empty to skip verification.
BYML_VERSION=1.0.2
BYML_SHA256=
