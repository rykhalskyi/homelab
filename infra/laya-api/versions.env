# Pinned laya-api container image deployed by infra/laya-api/.
#
# This file is intentionally committed and holds no secrets. Bump both values
# after publishing a new release in rykhalskyi/laya-api, then run
# `make laya-api-deploy` on node-one.
#
# LAYA_API_SHA256 is the immutable image digest (sha256:...) of
# LAYA_API_VERSION, published as the `laya-api-<version>.digest` release asset
# by the laya-api release workflow. Leave it empty to skip digest pinning.
LAYA_API_VERSION=0.1.0
LAYA_API_SHA256=
