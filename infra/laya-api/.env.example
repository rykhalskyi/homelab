# Copy to .env before deploying. deploy.sh does this for you on first run,
# generating LAYA_ADMIN_KEY automatically. .env is git-ignored - never commit it.
#
# Generate a key manually with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
LAYA_ADMIN_KEY=replace_with_a_long_random_value

# Host port the API is published on (container listens on 8000). Default 8001.
# LAYA_HOST_PORT=8001

# Optional: only needed if the GHCR image package is private.
# GHCR_TOKEN=ghp_xxx
# GHCR_USER=rykhalskyi
