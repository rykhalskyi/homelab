# Pinned app releases baked into the custom Nextcloud image.
#
# This file is intentionally committed and holds no secrets. Bump a version
# after publishing a release in the app repo, then merge the pin PR so the
# image build picks it up.
#
# The SHA256 values are checksums of <app>-<version>.tar.gz as published by
# each app repo's release workflow.
BYML_VERSION=1.1.0
BYML_SHA256=7ecab6a31f9f362e855b393b5893221f0722e29fa16b5ac05439493cdfcd1070

# BookTailor (rykhalskyi/booktailor), baked into /opt/booktailor.
BOOKTAILOR_VERSION=1.8.0
BOOKTAILOR_SHA256=6ffec044fc4d752ac41afe9e007d356fa7aae1f23200627026058121b560d721

# Base image for the custom Nextcloud image built from those release tarballs
# (see infra/images/nextcloud/Dockerfile and
# .github/workflows/build-nextcloud-image.yml). Bumped one major at a time
# (the Nextcloud entrypoint refuses jumps >1 major); the apps support 31-35.
NEXTCLOUD_VERSION=35.0.2-apache
